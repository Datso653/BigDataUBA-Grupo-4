# ============================================
# ÍTEM 6 — Elbow (inercia) para k=1..10
# Gráfico: elbow_kmeans.png
# ============================================

inertia = []
K = range(1, 11)
for k in K:
    km = KMeans(n_clusters=k, n_init=20, random_state=42)
    km.fit(X_scaled)
    inertia.append(km.inertia_)

plt.figure(figsize=(7,5))
plt.plot(list(K), inertia, "o-")
plt.xlabel("Número de clusters (k)")
plt.ylabel("Inercia (Suma de distancias a centroides)")
plt.title("Método del Codo (Elbow) — KMeans")
plt.xticks(list(K))
plt.grid(True, alpha=0.3)
plt.tight_layout()
fname = os.path.join(OUTDIR, "elbow_kmeans.png")
plt.savefig(fname, dpi=200)
plt.close()
print(f"✔ Guardado: {fname}")


