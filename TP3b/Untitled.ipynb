# ============================================
# PARTE II — CLUSTER (Sección completa)
# Requiere: df ya cargado (p.ej., respondieron_final.xlsx)
# Variables esperadas: ['edad','edad2','educ','ITF','n_personas','horastrab']
# Salida de figuras: ./figs/
# ============================================

import os
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns  # asumimos que está disponible
from sklearn.preprocessing import StandardScaler
from sklearn.cluster import KMeans
from scipy.cluster.hierarchy import linkage, dendrogram

# Carpeta de salida para las figuras
OUTDIR = "figs"
os.makedirs(OUTDIR, exist_ok=True)

# Variables usadas (mismas que PCA)
variables_cluster = ['edad', 'edad2', 'educ', 'ITF', 'n_personas', 'horastrab']
assert all(v in df.columns for v in variables_cluster), \
    f"Faltan columnas en df. Esperadas: {variables_cluster} | Encontradas: {list(df.columns)}"

# Construir matriz X (solo estas columnas), limpiar y estandarizar
X = df[variables_cluster].apply(pd.to_numeric, errors='coerce') \
                         .replace([np.inf, -np.inf], np.nan) \
                         .dropna()
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

# df_cluster queda alineado 1:1 con X (misma indexación)
df_cluster = df.loc[X.index].copy()

print(f"Observaciones totales en df: {len(df)}")
print(f"Observaciones válidas para Cluster (sin NA en vars): {len(df_cluster)}")


[ ]
3 s
# ============================================
# ÍTEM 5 — K-means con k=2,3,4 (n_init=20)
# Gráficos: Edad (x) vs ITF (y), color por cluster
# Salida de figuras: cluster_scatter_edad_itf_k{2,3,4}.png
# ============================================

ks = [2, 3, 4]
for k in ks:
    km = KMeans(n_clusters=k, n_init=20, random_state=42)
    df_cluster[f"cluster_k{k}"] = km.fit_predict(X_scaled)

    # Scatter Edad vs ITF (seaborn)
    plt.figure(figsize=(7,5))
    sns.scatterplot(
        x=df_cluster['edad'],
        y=df_cluster['ITF'],
        hue=df_cluster[f"cluster_k{k}"],
        palette="viridis",
        alpha=0.75,
        legend='full'
    )
    plt.xlabel("Edad")
    plt.ylabel("Ingreso total familiar (ITF)")
    plt.title(f"Clusters k-means (k={k}) — Edad vs ITF")
    plt.tight_layout()
    fname = os.path.join(OUTDIR, f"cluster_scatter_edad_itf_k{k}.png")
    plt.savefig(fname, dpi=200)
    plt.close()
    print(f"✔ Guardado: {fname}")

# Devolver etiquetas al df original (solo filas sin NA usadas en Cluster)
for k in ks:
    df.loc[df_cluster.index, f"cluster_k{k}"] = df_cluster[f"cluster_k{k}"]

print("✔ Columnas agregadas a df:", [f"cluster_k{k}" for k in ks])


